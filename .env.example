PORT=5005
ORIGIN=http://localhost:5173
MONGODB_URI=
TOKEN_SECRET=

# Cloudinary blocks PDF and ZIP delivery on new accounts by default.
# Uploads still succeed and return a secure_url, but the URL won't open.
# Enable it at: Cloudinary console > Settings > Security > "Allow delivery of PDF and ZIP files"
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=